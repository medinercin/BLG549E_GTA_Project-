  {
    "sha": "73d6504063bfa00666a92b07a28aaf906c532f09",
    "message": "Merge commit from fork\n\nSessions: fix signing key selection when key rotation is enabled",
    "date": "2025-05-13T14:46:54Z",
    "is_bug_fix": true,
    "files": [
      {
